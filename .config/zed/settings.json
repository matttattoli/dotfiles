// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "llama.cpp": {
      "api_url": "http://localhost:9931",
    },
  },
  "autosave": "on_focus_change",
  "disable_ai": false,
  "ui_font_family": "Hack",
  "buffer_font_family": "Hack",
  "terminal": {
    "font_family": "Hack",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "cursor_shape": "block",
  "cursor_blink": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "project_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "llama.cpp",
      "model": "unsloth/gemma-4-12B-it-qat-GGUF:Q4_K_XL",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "proxy": "",
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "max_output_tokens": 64,
      "model": "unsloth/gemma-4-12B-it-qat-GGUF:MTP",
      "api_url": "http://localhost:9931",
    },
    "allow_data_collection": "no",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "file_types": {
    "env": ["*.env.*"],
    "ignore": [".gcloudignore"],
  },
}
